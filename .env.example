# Environment
NODE_ENV=development

# Server Ports
PORT=3000
METRICS_PORT=9463

# Bootstrap-static dashboard/security keys (required)
# DASHBOARD_SECRET_KEY: at least 32 UTF-8 bytes
DASHBOARD_SECRET_KEY=
# SETTINGS_ENCRYPTION_KEY: exactly 32 UTF-8 bytes; rotating it requires re-encryption
SETTINGS_ENCRYPTION_KEY=

# Database Configuration
DB_HOST=localhost
DB_PORT=3309
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=lxp_code_review

# Redis Queue Configuration
REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_PASSWORD=
REDIS_QUEUE_DB=0

# One-time runtime settings import defaults (first boot only)
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000

# Codex CLI Configuration
CODEX_BINARY_PATH=codex
CODEX_TIMEOUT_MS=600000
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=medium
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://custom-endpoint.example.com/v1

# Custom Review Prompt (optional, appended to base prompt)
# Per-repo mapping (repo slug → filepath) takes precedence; unmapped repos fall back to REVIEW_CUSTOM_PROMPT_FILEPATH
# REVIEW_REPO_CUSTOM_PROMPT_FILEPATHS='{"frontend-app":"/prompts/javascript_guidelines.md","api-server":"/prompts/backend_guidelines.md"}'
# REVIEW_CUSTOM_PROMPT_FILEPATH=/path/to/custom-prompt.md
# Required when any per-repo import map above or below is non-empty
# RUNTIME_SETTINGS_REPOSITORY_WORKSPACE_MAP='{"frontend-app":"workspace-slug","api-server":"workspace-slug"}'

# Bitbucket Configuration
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_API_TOKEN=your_api_token
# (deprecated) App Password 방식 - API Token이 없을 때 fallback으로 사용
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
BITBUCKET_WEBHOOK_SECRET=
# Per-repo import maps use the same explicit workspace mapping above
# BITBUCKET_REPO_TOKENS='{"frontend-app":"token"}'
# BITBUCKET_REPO_WEBHOOK_SECRETS='{"frontend-app":"secret"}'

# Workspace Configuration
WORKSPACE_BASE_PATH=/tmp/code-review-workspaces
GIT_CLONE_TIMEOUT_MS=600000
# 리뷰 워커의 동시 처리 건수(BullMQ concurrency). 같은 repo의 worktree 준비는
# 내부에서 직렬화되므로 codex exec만 병렬로 돈다.
WORKSPACE_MAX_CONCURRENT=3

# Review Trigger Mode (mention | auto | both)
REVIEW_TRIGGER_MODE=mention

# Logging
LOG_LEVEL=info

# TypeORM Configuration
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Database Connection Pool
DB_POOL_SIZE=5
DB_POOL_MAX_IDLE=2

# OpenTelemetry Configuration (optional)
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SERVICE_VERSION=1.0.0
